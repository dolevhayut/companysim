{
  "name": "companysim",
  "version": "0.1.0-alpha.2",
  "type": "module",
  "private": false,
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.32.1",
  "bin": {
    "company": "dist/packages/cli/src/index.js",
    "companysim": "dist/packages/cli/src/index.js"
  },
  "files": [
    "dist",
    "apps/web/dist",
    "README.md"
  ],
  "scripts": {
    "dev": "tsx packages/cli/src/index.ts serve",
    "company": "tsx packages/cli/src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint packages apps/web/src tests",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json && vite build apps/web",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "test:e2e": "playwright test",
    "test:docker": "node scripts/docker-smoke.mjs",
    "format": "prettier --write packages apps/web/src tests",
    "format:check": "prettier --check packages apps/web/src tests"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@hono/node-server": "^2.1.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "hono": "^4.13.8",
    "lucide-react": "^1.47.0",
    "openai": "^7.20.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.11.0",
    "prettier": "^3.9.8",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "description": "A local synthetic company for AI agents, integration tests and demos. Browser, REST, MCP and CLI over one coherent dataset.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dolevhayut/companysim.git"
  },
  "bugs": {
    "url": "https://github.com/dolevhayut/companysim/issues"
  },
  "homepage": "https://github.com/dolevhayut/companysim#readme"
}
