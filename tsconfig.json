{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "types": ["node", "vitest/globals", "vite/client"],
    "outDir": "dist",
    "rootDir": "."
  },
  "include": ["packages/**/*.ts", "apps/**/*.tsx", "tests/**/*.ts"]
}
